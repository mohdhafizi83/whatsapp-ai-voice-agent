# Voice Agent — Environment Variables

# --- Bluetooth HFP ---
BT_PHONE_MAC=AA:BB:CC:DD:EE:FF

# --- Gemini ---
GEMINI_API_KEY=your_api_key_here

# --- MiMo TTS (Mode 2: Interview - Voice Clone) ---
# Guna XIAOMI_API_KEY yang sama dengan cron jobs
XIAOMI_API_KEY=your_xiaomi_api_key_here

# --- ElevenLabs (ALTERNATIVE - optional, RM23/bln) ---
# ELEVENLABS_API_KEY=your_api_key_here
# ELEVENLABS_VOICE_ID=your_voice_id_here

# --- Mode ---
# "sales" = Mode 1 (Gemini audio direct)
# "interview" = Mode 2 (Gemini → MiMo TTS voice clone)
AGENT_MODE=sales

# --- Admin API (required to access /api/leads and /api/mode) ---
# Generate: openssl rand -hex 32
ADMIN_API_KEY=
